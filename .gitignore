mlruns/
mlartifacts/
models/
*.onnx
*.pt
*.pkl

# Infra state
.terraform/
*.tfstate
*.tfstate.*

# Editors / OS
.vscode/
.idea/
.DS_Store

# Geospatial outputs (large; DVC or MinIO, not git)
*.tif
*.tiff
*.zarr/
*.nc
*.SAFE/
*.aux.xml
